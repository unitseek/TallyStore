* text=auto eol=lf

# Windows 批处理/脚本按 CRLF 检出一致（仓库当前无此类文件；规则为未来新增时兜底）
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 已知二进制格式禁止行尾/文本归一化，防 Git「文本启发式」误判后损坏产物
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.jar   binary
*.class binary
*.so    binary
*.dll   binary
*.exe   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.wasm  binary
