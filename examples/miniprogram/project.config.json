{
  "description": "TallyStore 原生小程序 demo（手工同步 dist-weapp，不用 npm install）",
  "appid": "touristappid",
  "projectname": "tallystore-demo",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "libVersion": "3.17.4",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "ignoreUploadUnusedFiles": true,
    "compileHotReLoad": true,
    "skylineRenderEnable": true,
    "compileWorklet": true,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "packOptions": {
    "ignore": [],
    "include": []
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "simulatorPluginLibVersion": {}
}
